NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: URL of the frozen 2026 deployment. Shows an archive link in the footer.
NEXT_PUBLIC_ARCHIVE_2026_URL=
# Admin credentials and session signing secret (server-side only; no default credentials).
ADMIN_EMAIL=
# Use a unique password of at least 12 characters. Quote values containing #.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional separate database for the 2026 kv_store; otherwise DATABASE_URL is used.
LEGACY_DATABASE_URL=
# Neon Postgres connection string for the /your-voice feedback endpoint (server-side only).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
